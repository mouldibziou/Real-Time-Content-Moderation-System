# Copy to .env.docker and supply deployment credentials there.
# db and redis must resolve on the container's network. In cloud both are
# managed addresses; locally they are compose service names.
DATABASE_URL=postgresql+asyncpg://toxicity:replace-me@db:5432/toxicity
REDIS_URL=redis://redis:6379/0
EXPLAIN_QUEUE_KEY=expl_jobs
MODEL_VERSION=v2.0.0
TOXICITY_DEVICE=cpu
TOXICITY_INFERENCE_BACKEND=onnx
