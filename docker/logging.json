{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "standard": {
      "()": "app.observability.JsonFormatter",
      "service": "api"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "standard",
      "stream": "ext://sys.stdout"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["console"]
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": ["console"],
      "propagate": false
    }
  }
}
