            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
