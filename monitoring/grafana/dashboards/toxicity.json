        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Queue collection (1 = healthy)",
      "type": "stat",
      "description": "Whether the latest background database query succeeded. Queue depth is omitted on failure, never replaced with a false zero.",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(explanation_queue_collection_success{job=\"toxicity_api\"})",
          "legendFormat": "Database scrape",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 15,
      "title": "Current classification requests",
      "type": "stat",
      "description": "Accepted classification requests waiting in the executor or running model inference. A batch counts as one request. Excludes database persistence and HTTP requests rejected before reaching the application.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (classification_requests_current{job=\"toxicity_api\"})",
          "legendFormat": "{{state}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 0,
          "noValue": "Unavailable",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 16,
      "title": "Reading these measurements",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Classifications:** queued = waiting for model inference; running = currently inferring. Batches count as one request.\n\n**Explanations:** durable background jobs waiting for or running on the worker.\n\n**0% positive** can be correct for neutral text. Latency is unavailable when no requests/jobs occurred in its recent window."
      }
    },
    {
      "id": 5,
      "title": "HTTP requests per second",
      "type": "timeseries",
      "description": "Health checks and metrics scrapes are excluded. Route templates keep cardinality bounded.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_requests_total{job=\"toxicity_api\"}[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "HTTP p95 latency",
      "type": "timeseries",
      "description": "Application response latency, including database work. Async /explain measures submission, not job completion. No recent requests/jobs means no latency estimate; zero is not substituted for missing observations.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{job=\"toxicity_api\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "No recent observations"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "HTTP responses in selected time range",
      "type": "bargauge",
      "description": "Windowed counts are estimates between scrapes; the demo includes intentional validation errors (422).",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_code) (increase(http_requests_total{job=\"toxicity_api\"}[$__range]))",
          "legendFormat": "HTTP {{status_code}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 8,
      "title": "Positive predictions by label",
      "type": "bargauge",
      "description": "Positive share of successful classifications since API start, using model thresholds. Neutral load-test text can correctly yield 0%. Each label is independent. Empty before any classifications or while metrics are unavailable.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (classification_predictions_total{job=\"toxicity_api\",decision=\"positive\"}) / (sum by (label) (classification_predictions_total{job=\"toxicity_api\"}) > 0)",
          "legendFormat": "{{label}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "min": 0,
          "max": 1,
          "decimals": 2,
          "noValue": "No predictions / unavailable"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
