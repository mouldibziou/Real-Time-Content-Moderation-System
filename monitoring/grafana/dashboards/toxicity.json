        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "toxicity-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (explanation_jobs_current{job=\"toxicity_api\"})",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
